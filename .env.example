# GEMINI_API_KEY: Required for Google Gemini AI reconstruction (primary provider).
GEMINI_API_KEY=

# OPENAI_API_KEY: Optional key for OpenAI reconstruction (first fallback provider).
OPENAI_API_KEY=

# XAI_API_KEY: Optional key for xAI Grok reconstruction (second fallback provider).
XAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
